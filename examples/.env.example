# vSphere Connection Settings
# Copy this file to .env and update with your actual credentials

# vCenter or ESXi server URL (without https://)
VIM_SERVER=vcenter.example.com

# Username for authentication
VIM_USERNAME=administrator@vsphere.local

# Password for authentication
VIM_PASSWORD=your-password-here

# Optional: VM-specific settings for examples
VM_INVENTORY_PATH=/Datacenter/vm/MyVM
NEW_VM_NAME=MyRenamedVM
COMPUTE_RESOURCE=MyCluster

DATASTORE=datastore-147001